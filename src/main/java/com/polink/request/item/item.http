@baseUrl = http://localhost:8080

# 이미지 첨부 요청을 실행할 때만 실제 존재하는 이미지 파일 경로로 수정한다.
@imagePath = C:/Users/user/Downloads/item.png

###
# 0-1. 시민 로그인
# 실행 후 citizenToken이 자동 저장된다.
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "userName": "miran",
  "password": "miran12!"
}

> {% client.global.set("citizenToken", response.body.accessToken); %}

###
# 0-2. 경찰 로그인
# 실행 후 policeToken이 자동 저장된다.
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "userName": "shin",
  "password": "police1!"
}

> {% client.global.set("policeToken", response.body.accessToken); %}

###
# ITEM-001. 시민이 분실물 등록
# 성공하면 createdLostItemId에 새 분실물 번호가 저장된다.
POST {{baseUrl}}/api/v1/items
Authorization: Bearer {{citizenToken}}
Content-Type: multipart/form-data; boundary=lostItemBoundary

--lostItemBoundary
Content-Disposition: form-data; name="itemType"

LOST
--lostItemBoundary
Content-Disposition: form-data; name="itemName"

HTTP 테스트 검은 카드지갑
--lostItemBoundary
Content-Disposition: form-data; name="category"

WALLET_CARD
--lostItemBoundary
Content-Disposition: form-data; name="description"

교통카드와 학생증이 들어 있는 검은 카드지갑입니다.
--lostItemBoundary
Content-Disposition: form-data; name="location"

청솔역 1번 출구
--lostItemBoundary
Content-Disposition: form-data; name="occurredAt"

2026-10-20
--lostItemBoundary--

> {% client.global.set("createdLostItemId", response.body.itemId); %}

###
# ITEM-002. 시민이 습득물 등록
# 성공하면 createdFoundItemId에 새 습득물 번호가 저장된다.
POST {{baseUrl}}/api/v1/items
Authorization: Bearer {{citizenToken}}
Content-Type: multipart/form-data; boundary=foundItemBoundary

--foundItemBoundary
Content-Disposition: form-data; name="itemType"

FOUND
--foundItemBoundary
Content-Disposition: form-data; name="itemName"

HTTP 테스트 파란 우산
--foundItemBoundary
Content-Disposition: form-data; name="category"

CLOTHING_GOODS
--foundItemBoundary
Content-Disposition: form-data; name="description"

청솔역 대합실에서 발견한 파란 우산입니다.
--foundItemBoundary
Content-Disposition: form-data; name="location"

청솔역 대합실
--foundItemBoundary
Content-Disposition: form-data; name="occurredAt"

2026-10-20
--foundItemBoundary--

> {% client.global.set("createdFoundItemId", response.body.itemId); %}

###
# ITEM-003. 전체 물품 목록 조회
GET {{baseUrl}}/api/v1/items?page=0&size=10
Authorization: Bearer {{citizenToken}}

###
# ITEM-004. 분실물만 조회
GET {{baseUrl}}/api/v1/items?itemType=LOST&page=0&size=10
Authorization: Bearer {{citizenToken}}

###
# ITEM-005. 보관 중인 습득물만 조회
GET {{baseUrl}}/api/v1/items?itemType=FOUND&status=STORED&page=0&size=10
Authorization: Bearer {{citizenToken}}

###
# ITEM-006. 물품명 또는 설명에 '지갑'이 포함된 물품 조회
GET {{baseUrl}}/api/v1/items?keyword=지갑&page=0&size=10
Authorization: Bearer {{citizenToken}}

###
# ITEM-007. 카테고리와 장소 조건으로 조회
GET {{baseUrl}}/api/v1/items?itemType=LOST&category=WALLET_CARD&location=청솔역&page=0&size=10
Authorization: Bearer {{citizenToken}}

###
# ITEM-008. 발생일 범위로 조회
GET {{baseUrl}}/api/v1/items?startDate=2026-10-01&endDate=2026-10-22&page=0&size=10
Authorization: Bearer {{citizenToken}}

###
# ITEM-009. 방금 등록한 분실물 상세 조회
GET {{baseUrl}}/api/v1/items/{{createdLostItemId}}
Authorization: Bearer {{citizenToken}}

###
# ITEM-010. 방금 등록한 습득물 상세 조회
GET {{baseUrl}}/api/v1/items/{{createdFoundItemId}}
Authorization: Bearer {{citizenToken}}

###
# ITEM-011. 시민이 본인이 등록한 물품 목록 조회
GET {{baseUrl}}/api/v1/items/my?page=0&size=10
Authorization: Bearer {{citizenToken}}

###
# ITEM-012. 시민이 방금 등록한 분실물 수정
PATCH {{baseUrl}}/api/v1/items/{{createdLostItemId}}
Authorization: Bearer {{citizenToken}}
Content-Type: application/json

{
  "itemName": "수정된 HTTP 테스트 검은 카드지갑",
  "category": "WALLET_CARD",
  "description": "교통카드와 학생증이 들어 있는 수정된 검은 카드지갑입니다.",
  "location": "청솔역 2번 출구",
  "occurredAt": "2026-10-20"
}

###
# ITEM-013. 경찰이 방금 등록한 습득물 수정
PATCH {{baseUrl}}/api/v1/items/{{createdFoundItemId}}
Authorization: Bearer {{policeToken}}
Content-Type: application/json

{
  "itemName": "수정된 HTTP 테스트 파란 우산",
  "category": "CLOTHING_GOODS",
  "description": "청솔역 안내데스크에 보관 중인 수정된 파란 우산입니다.",
  "location": "청솔역 안내데스크",
  "occurredAt": "2026-10-20"
}

###
# ITEM-014. 시민이 본인의 분실물에 이미지 한 장 첨부
# @imagePath 경로에 실제 이미지 파일이 있어야 한다.
POST {{baseUrl}}/api/v1/items/{{createdLostItemId}}/image
Authorization: Bearer {{citizenToken}}
Content-Type: multipart/form-data; boundary=imageBoundary

--imageBoundary
Content-Disposition: form-data; name="image"; filename="item.png"
Content-Type: image/png

< {{imagePath}}
--imageBoundary--

###
# ITEM-015. AI 습득물 후보 매칭
# 방금 등록한 내 분실물을 기준으로 보관 중인 습득물을 조회한다.
POST {{baseUrl}}/api/v1/ai/item-matches
Authorization: Bearer {{citizenToken}}
Content-Type: application/json

{
  "lostItemId": "{{createdLostItemId}}"
}

###
# ITEM-016. 경찰이 전체 물품 통계 조회
GET {{baseUrl}}/api/v1/items/statistics
Authorization: Bearer {{policeToken}}

###
# ITEM-017. 토큰 없이 목록 조회: 401 확인
GET {{baseUrl}}/api/v1/items?page=0&size=10

###
# ITEM-018. 경찰이 물품 등록 시도: 403 확인
POST {{baseUrl}}/api/v1/items
Authorization: Bearer {{policeToken}}
Content-Type: multipart/form-data; boundary=forbiddenBoundary

--forbiddenBoundary
Content-Disposition: form-data; name="itemType"

LOST
--forbiddenBoundary
Content-Disposition: form-data; name="itemName"

경찰 등록 권한 테스트
--forbiddenBoundary
Content-Disposition: form-data; name="category"

ETC
--forbiddenBoundary
Content-Disposition: form-data; name="description"

경찰 계정은 물품을 등록할 수 없습니다.
--forbiddenBoundary
Content-Disposition: form-data; name="location"

테스트 장소
--forbiddenBoundary
Content-Disposition: form-data; name="occurredAt"

2026-10-20
--forbiddenBoundary--

###
# ITEM-019. 시민이 통계 조회 시도: 403 확인
GET {{baseUrl}}/api/v1/items/statistics
Authorization: Bearer {{citizenToken}}

###
# ITEM-020. 경찰이 내 등록 물품 조회 시도: 403 확인
GET {{baseUrl}}/api/v1/items/my?page=0&size=10
Authorization: Bearer {{policeToken}}

###
# ITEM-021. 존재하지 않는 물품 상세 조회: 404 확인
GET {{baseUrl}}/api/v1/items/L-9999
Authorization: Bearer {{citizenToken}}
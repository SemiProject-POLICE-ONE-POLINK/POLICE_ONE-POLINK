@baseUrl = http://localhost:8080
@citizenUserName = miran
@citizenPassword = miran12!
@policeUserName = shin
@policePassword = police1!
@adminUserName = admin
@adminPassword = admin12!
@officerId = 7

### 사전 조건
# 시민 계정이 없으면 case.http의 준비 요청을 먼저 실행합니다.
# 경찰 shin과 관리자 admin 계정은 테스트 DB에 별도로 준비해야 합니다.

### 0. 시민 로그인 → 토큰 자동 저장 — 예상: 200
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "userName": "{{citizenUserName}}",
  "password": "{{citizenPassword}}"
}

> {% client.global.set("citizenToken", response.body.accessToken); %}

### 1. 사건 관리 테스트용 사건 등록 → 사건번호 자동 저장 — 예상: 201
POST {{baseUrl}}/api/v1/cases
Authorization: Bearer {{citizenToken}}
Content-Type: application/json

{
  "title": "HTTP 담당 경찰 배정 및 종결 테스트",
  "caseType": "THEFT",
  "description": "담당 경찰 배정부터 사건 종결까지의 흐름을 검증합니다.",
  "occurredAt": "2026-10-22T10:00:00",
  "location": "서울역"
}

> {% client.global.set("managementCaseId", response.body.caseId); %}

### 2. 관리자 로그인 → 토큰 자동 저장 — 예상: 200
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "userName": "{{adminUserName}}",
  "password": "{{adminPassword}}"
}

> {% client.global.set("adminToken", response.body.accessToken); %}

### 3. 경찰 로그인 → 토큰 자동 저장 — 예상: 200
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "userName": "{{policeUserName}}",
  "password": "{{policePassword}}"
}

> {% client.global.set("policeToken", response.body.accessToken); %}

### 4. 관리자 사건 전체 목록 조회 — 예상: 200
GET {{baseUrl}}/api/v1/cases?page=0&size=10
Authorization: Bearer {{adminToken}}

### 5. 담당 경찰 배정 — 예상: 200
PATCH {{baseUrl}}/api/v1/cases/{{managementCaseId}}/officer
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "officerId": {{officerId}}
}

### 6. 경찰 담당 사건 목록 조회 — 예상: 200
GET {{baseUrl}}/api/v1/cases/my?page=0&size=10
Authorization: Bearer {{policeToken}}

### 7. 사건 종결 — 예상: 200
POST {{baseUrl}}/api/v1/cases/{{managementCaseId}}/close
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "closeReason": "HTTP 테스트 사건 처리 완료"
}

### 8. 종결된 사건 상세 조회 — 예상: 200
GET {{baseUrl}}/api/v1/cases/{{managementCaseId}}
Authorization: Bearer {{adminToken}}
